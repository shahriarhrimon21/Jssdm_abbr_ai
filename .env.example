# Copy this file to .env for local `netlify dev` use (never commit .env).
# In production, set these in Netlify: Site settings -> Environment variables.
# Each key is read ONLY by its provider file under netlify/functions/providers/
# and is never sent to, or bundled into, the browser code. You only need to
# set the key(s) for the provider(s) you actually use — the app's provider
# dropdown lets you pick per-request, and any provider without a key
# configured just reports "not configured" instead of failing hard.

# Groq — genuinely free, no credit card required. Get a key at
# https://console.groq.com/keys. This is the app's default provider.
GROQ_API_KEY=

# Optional: override the default Groq model without a code change.
# (Groq retires/renames models periodically — check
# https://console.groq.com/docs/models if you ever see a "model does
# not exist" error.)
# GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=

# Optional: override the default Gemini model without a code change.
# GEMINI_MODEL=gemini-3.6-flash

# Optional second provider — useful as a fallback if Gemini's API keys are
# temporarily unreliable (Google has been rolling out a new "AQ." key
# format; see the README's troubleshooting note). Get a key from
# platform.openai.com/api-keys (requires a billing method on your OpenAI
# account, unlike Gemini's free tier).
OPENAI_API_KEY=

# Optional: override the default OpenAI model without a code change.
# OPENAI_MODEL=gpt-5.6-terra
